<Application xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:local="using:CrossPlatformDownloadManager.DesktopApp"
             xmlns:vm="clr-namespace:CrossPlatformDownloadManager.DesktopApp.ViewModels"
             RequestedThemeVariant="Dark"
             x:Class="CrossPlatformDownloadManager.DesktopApp.App"
             x:DataType="vm:AppViewModel">

    <Application.DataTemplates>
        <local:ViewLocator />
    </Application.DataTemplates>

    <!-- Styles -->
    <Application.Styles>
        <!-- Theme -->
        <SimpleTheme />

        <!-- Avalonia Controls Theme -->
        <StyleInclude Source="avares://Avalonia.Controls.DataGrid/Themes/Simple.xaml" />

        <!-- My Custom Themes -->
        <StyleInclude Source="/Styles/WindowStyle.axaml" />
        <StyleInclude Source="/Styles/MenuItemStyle.axaml" />
        <StyleInclude Source="/Styles/ListBoxStyle.axaml" />
        <StyleInclude Source="/Styles/ActionButtonStyle.axaml" />
        <StyleInclude Source="/Styles/ToolTipStyle.axaml" />
        <StyleInclude Source="/Styles/DataGridStyle.axaml" />
        <StyleInclude Source="/Styles/GridCheckBoxStyle.axaml" />
        <StyleInclude Source="/Styles/TabItemToggleButtonStyle.axaml" />
        <StyleInclude Source="/Styles/ButtonStyles.axaml" />
        <StyleInclude Source="/Styles/ProgressBarStyle.axaml" />
        <StyleInclude Source="/Styles/FlyoutPresenterStyle.axaml" />
        <StyleInclude Source="/Styles/MenuFlyoutPresenterStyle.axaml" />
        <StyleInclude Source="/Styles/HyperlinkButtonStyle.axaml" />
        <StyleInclude Source="/Styles/ScrollBarStyle.axaml" />

        <!-- Custom Controls Themes -->
        <StyleInclude Source="/CustomControls/CustomTextBox.axaml" />
        <StyleInclude Source="/CustomControls/CustomComboBox.axaml" />
        <StyleInclude Source="/CustomControls/CustomNumericUpDown.axaml" />
        <StyleInclude Source="/CustomControls/CustomSelectBox.axaml" />
        <StyleInclude Source="/CustomControls/CustomRadioContentButton.axaml" />
        <StyleInclude Source="/CustomControls/CustomExpander.axaml" />
        <StyleInclude Source="/CustomControls/CustomToggleSwitch.axaml" />
    </Application.Styles>

    <!-- Resources -->
    <Application.Resources>
        <ResourceDictionary>
            <ResourceDictionary.MergedDictionaries>
                <MergeResourceInclude Source="/Resources/Fonts.axaml" />
                <MergeResourceInclude Source="/Resources/Colors.axaml" />
                <MergeResourceInclude Source="/Resources/Icons.axaml" />
                <MergeResourceInclude Source="/Resources/StaticData.axaml" />
            </ResourceDictionary.MergedDictionaries>
        </ResourceDictionary>
    </Application.Resources>

    <!-- TrayIcon -->
    <TrayIcon.Icons>
        <TrayIcons>
            <TrayIcon Icon="avares://CrossPlatformDownloadManager.DesktopApp/Assets/Images/cdm-logo.ico"
                      ToolTipText="Cross platform Download Manager (CDM)"
                      IsVisible="{Binding IsTrayIconVisible}"
                      Command="{Binding OpenMainWindowCommand}">
                <TrayIcon.Menu>
                    <NativeMenu>
                        <NativeMenuItem Header="Open"
                                        Command="{Binding OpenMainWindowCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Add new link"
                                        Command="{Binding AddNewLinkCommand}" />
                        <NativeMenuItem Header="Add new queue"
                                        Command="{Binding AddNewQueueCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Settings"
                                        Command="{Binding OpenSettingsWindowCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Help"
                                        Command="{Binding OpenCdmWebPageCommand}" />
                        <NativeMenuItem Header="About CDM"
                                        Command="{Binding OpenAboutUsWindowCommand}" />
                        <NativeMenuItemSeparator />
                        <NativeMenuItem Header="Exit"
                                        Command="{Binding ExitApplicationCommand}" />
                    </NativeMenu>
                </TrayIcon.Menu>
            </TrayIcon>
        </TrayIcons>
    </TrayIcon.Icons>
</Application>